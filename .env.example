# ==============================================================================
# 海马智慧门店 (Seahorse Smart Store) - 全栈环境变量配置模板 (.env.example)
# ==============================================================================
# 使用方式：
#   1. 复制本模板生成本地私有配置（已被 .gitignore 忽略，严禁提交真实密钥到 Git）：
#        copy .env.example .env
#   2. 本地启动脚本 (ops/01_本地开发运行/start.ps1、run-backend.bat、run-frontend.bat)
#      与容器编排 (docker-compose.yml) 均会自动读取 seahorse/.env 中的非空变量。
#   3. 远程生产环境审计与部署请配合 scripts/check_seahorse_env.py 使用。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Boot 核心运行环境与端口配置
# ------------------------------------------------------------------------------
# 留空时：本地 Maven 启动默认使用 dev，docker-compose.yml 默认使用 prod
# 可选值: dev | prod
SPRING_PROFILES_ACTIVE=

# 后端 HTTP 监听端口（本地开发与本地 Docker Compose 默认 8082；云端 Node 2 容器使用 8080）
SERVER_PORT=8082

# 是否在控制台打印格式化 SQL（仅建议本地调试开启: true | false）
JPA_SHOW_SQL=false

# ------------------------------------------------------------------------------
# 2. MySQL 数据库连接配置 (Spring DataSource)
# ------------------------------------------------------------------------------
# 留空时自动按运行模式回退：
#   - 本地开发 (dev): jdbc:mysql://127.0.0.1:3306/seahorse_store?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
#   - 本地容器 (docker-compose): jdbc:mysql://seahorse-mysql:3306/seahorse_store?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
#   - 生产环境 (RDS 示例): jdbc:mysql://<your-rds-host>:3306/seahorse_store?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_URL=

# 数据库账号与口令（本地开发/本地容器默认 root / root123456；生产环境请注入独立最小权限凭据）
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root123456

# ------------------------------------------------------------------------------
# 3. JWT 令牌签名安全密钥 (必须 >= 32 字节 / 256 bits)
# ------------------------------------------------------------------------------
# 警告：生产环境严禁使用默认示例值！请使用至少 32 字节高熵随机字符串（如 openssl rand -hex 32）
SEAHORSE_JWT_SECRET=seahorse-dev-only-jwt-secret-key-replace-in-production-2026

# ------------------------------------------------------------------------------
# 4. 高德地图 (AMap) 开放平台密钥配置（服务端兜底 + Web 前端地图/考勤围栏）
# ------------------------------------------------------------------------------
# 服务端接口 (/api/config/amap) 与种子脚本 (scripts/reset_and_init_data.py) 读取：
SEAHORSE_AMAP_WEB_KEY=
SEAHORSE_AMAP_JS_KEY=
SEAHORSE_AMAP_SECURITY_CODE=

# Web 前端构建期/开发期环境变量 (Vite import.meta.env.VITE_*)：
VITE_AMAP_WEB_KEY=
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=

# ------------------------------------------------------------------------------
# 5. 数据重置与初始化脚本可选覆盖项 (scripts/reset_and_init_data.py)
# ------------------------------------------------------------------------------
SEAHORSE_DB_HOST=127.0.0.1
SEAHORSE_DB_PORT=3306
SEAHORSE_DB_USER=root
SEAHORSE_DB_PASSWORD=
SEAHORSE_DB_NAME=seahorse_store

# ------------------------------------------------------------------------------
# 6. 远程云端 Docker 运维与部署认证 (ops/02_远程Docker部署/deploy_engine.py)
# ------------------------------------------------------------------------------
# 推荐通过仓库根目录 .secrets/fwpt_credentials.json 或 SSH 私钥配置，切勿提交密码明文！
FWPT_NODE2=39.97.158.22
FWPT_SSH_USER=root
FWPT_SSH_KEY=
FWPT_SSH_PASSWORD=
