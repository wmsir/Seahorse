{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SeahorseStore",
  "version": "1.0.0",
  "identifier": "com.seahorse.desktop",
  "build": {
    "frontendDist": "../../seahorse_web_front/dist-desktop",
    "devUrl": "http://localhost:3000/seahorse/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "海马智慧门店 (Seahorse Store) v1.0.0",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
