<view class="container">
  <view class="card">
    <view class="pay-title">海马智慧门店在线买单</view>
    <view class="pay-space">工位/桌台: 1号精剪镜台 (M01)</view>
    <view class="pay-amount-box">
      <text class="yen">￥</text>
      <text class="num">88.00</text>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">选择支付方式</view>
    <radio-group class="channel-group" bindchange="handleChannelChange">
      <label class="channel-item">
        <view class="ci-left">
          <text class="ci-icon">🟢</text>
          <text>微信支付</text>
        </view>
        <radio value="WECHAT" checked="true" />
      </label>
      <label class="channel-item">
        <view class="ci-left">
          <text class="ci-icon">🟣</text>
          <text>会员双轨储值抵扣 (可用: ￥2150)</text>
        </view>
        <radio value="STORED_VALUE" />
      </label>
    </radio-group>
  </view>

  <button class="primary-btn pay-btn" bindtap="handleDoPay">立即支付 ￥88.00</button>
</view>
