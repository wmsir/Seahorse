.pay-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.pay-space {
  font-size: 24rpx;
  color: #64748b;
  text-align: center;
  margin-top: 8rpx;
}

.pay-amount-box {
  text-align: center;
  margin-top: 32rpx;
  color: #ef4444;
}

.yen {
  font-size: 40rpx;
  font-weight: 700;
}

.num {
  font-size: 64rpx;
  font-weight: 700;
}

.channel-group {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
}

.channel-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.ci-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
}

.pay-btn {
  margin-top: 40rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 32rpx;
}
