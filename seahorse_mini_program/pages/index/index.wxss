.hero-banner {
  background: linear-gradient(135deg, #0f172a, #0369a1);
  color: #ffffff;
  padding: 36rpx 28rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.brand-badge {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.brand-slogan {
  font-size: 26rpx;
  color: #38bdf8;
  margin-top: 10rpx;
  font-weight: 600;
}

.store-meta {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 12rpx;
}

.scan-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background-color: #ffffff;
  border: 2rpx solid #38bdf8;
}

.scan-icon {
  font-size: 48rpx;
}

.scan-text {
  flex: 1;
}

.scan-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.scan-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.scan-arrow {
  font-size: 32rpx;
  color: #0284c7;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.sec-title {
  font-size: 28rpx;
  font-weight: 700;
}

.sec-refresh {
  font-size: 24rpx;
  color: #0284c7;
}

.space-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.space-item {
  padding: 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
}

.item-idle {
  background-color: #f0fdf4;
  border-color: #86efac;
}

.item-occupied {
  background-color: #f0f9ff;
  border-color: #7dd3fc;
}

.item-name {
  font-size: 26rpx;
  font-weight: 700;
}

.item-status {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.product-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.p-name {
  font-size: 28rpx;
  font-weight: 600;
}

.p-desc {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.p-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.order-mini-btn {
  background-color: #0284c7;
  color: #fff;
  font-size: 22rpx;
  padding: 0 20rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 24rpx;
}
