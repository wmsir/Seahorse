.session-bar {
  background-color: #0f172a;
  color: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.bar-space {
  font-size: 28rpx;
  font-weight: 700;
  display: block;
}

.bar-hint {
  font-size: 20rpx;
  color: #38bdf8;
  margin-top: 4rpx;
  display: block;
}

.bar-status {
  background-color: #0284c7;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.menu-container {
  padding-bottom: 140rpx;
}

.product-item {
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.p-title {
  font-size: 28rpx;
  font-weight: 600;
}

.p-sub {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.p-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #ef4444;
  margin-top: 10rpx;
}

.add-cart-btn {
  background-color: #e0f2fe;
  color: #0284c7;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 30rpx;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-top: 1rpx solid #e2e8f0;
  padding: 20rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.05);
}

.cart-count {
  font-size: 22rpx;
  color: #64748b;
}

.cart-total {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.submit-btn {
  font-size: 28rpx;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
}
