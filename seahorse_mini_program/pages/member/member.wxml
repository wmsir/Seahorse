<view class="container">
  <!-- 会员专属卡片 -->
  <view class="member-card">
    <view class="mc-top">
      <view class="mc-user">
        <view class="mc-avatar">{{ profile.member.name ? profile.member.name[0] : '会' }}</view>
        <view class="mc-info">
          <view class="mc-name">{{ profile.member.name || '尊享会员' }} <text class="mc-level-badge">{{ profile.levelName || profile.member.level || '普卡会员' }}</text></view>
          <view class="mc-no">{{ profile.member.memberNo || 'HM000001' }} · {{ profile.member.phone || '未绑定手机' }}</view>
        </view>
      </view>
      <view class="mc-slogan">海马会员 · 记住每位好客</view>
    </view>

    <!-- 双轨储值总览 -->
    <view class="mc-balance-grid">
      <view class="bg-item">
        <text class="bg-label">储值总额</text>
        <text class="bg-val">￥{{ totalDisplay }}</text>
      </view>
      <view class="bg-item">
        <text class="bg-label">本金余额</text>
        <text class="bg-val">￥{{ principalDisplay }}</text>
      </view>
      <view class="bg-item">
        <text class="bg-label">赠送金</text>
        <text class="bg-val text-amber">￥{{ giftDisplay }}</text>
      </view>
    </view>
  </view>

  <!-- 海马体记忆画像特色卡片 -->
  <view class="card hippocampus-card">
    <view class="sec-title">🧠 我的“海马体”记忆偏好</view>
    <view class="sec-sub">系统已为您牢记以下个性化服务喜好与习惯：</view>

    <view class="pref-container">
      <view class="pref-badge-row" wx:if="{{ profile.preferences && profile.preferences.length > 0 }}">
        <text class="pref-pill" wx:for="{{ profile.preferences }}" wx:key="id">{{ item.tagValue || item.notes }}</text>
      </view>
      <view class="pref-badge-row" wx:else>
        <text class="pref-pill">暂无偏好记录，到店服务后自动沉淀</text>
      </view>
    </view>
  </view>

  <!-- 计次卡资产 -->
  <view class="card">
    <view class="sec-title">🎟️ 可用计次卡包</view>
    <view class="tc-item" wx:for="{{ profile.timeCards }}" wx:key="id">
      <view class="tc-left">
        <view class="tc-title">{{ item.skuName }}</view>
        <view class="tc-date">有效期至: {{ item.expireDate }}</view>
      </view>
      <view class="tc-right">
        <text class="tc-remain">剩余 {{ item.remainingTimes }} 次</text>
      </view>
    </view>
  </view>
</view>
