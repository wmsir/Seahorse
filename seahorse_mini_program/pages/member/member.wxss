.member-card {
  background: linear-gradient(135deg, #0f172a, #0369a1);
  color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(3, 105, 161, 0.2);
}

.mc-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.mc-user {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.mc-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #38bdf8;
  color: #0f172a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
}

.mc-name {
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mc-level-badge {
  background-color: #f59e0b;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.mc-no {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.mc-slogan {
  font-size: 20rpx;
  color: #38bdf8;
}

.mc-balance-grid {
  display: flex;
  justify-content: space-around;
  margin-top: 36rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
  padding-top: 24rpx;
}

.bg-item {
  text-align: center;
}

.bg-label {
  font-size: 22rpx;
  color: #94a3b8;
  display: block;
}

.bg-val {
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 6rpx;
  display: block;
}

.text-amber {
  color: #fde047;
}

.hippocampus-card {
  background-color: #faf5ff;
  border: 1rpx solid #e9d5ff;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.sec-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.pref-badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.pref-pill {
  background-color: #f3e8ff;
  color: #6b21a8;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  border: 1rpx solid #d8b4fe;
}

.tc-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.tc-title {
  font-size: 28rpx;
  font-weight: 600;
}

.tc-date {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.tc-remain {
  color: #0284c7;
  font-size: 26rpx;
  font-weight: 700;
}
